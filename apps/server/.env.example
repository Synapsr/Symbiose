# Copy to .env for local development (pnpm dev:server)
ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=   # only for keys not scoped to a workspace
# AI_MODEL=claude-opus-5-5
# Another AI provider: openai, mistral, gemini, openrouter, ollama or openai-compatible
# AI_PROVIDER=ollama
# AI_API_KEY=               # or OPENAI_API_KEY, MISTRAL_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY
# AI_BASE_URL=http://localhost:11434/v1
# AI_VISION=false           # for a model that can't read photos
# PORT=3000
# DATA_DIR=./data
# SIGNUP=closed   # open, request or closed
# PUBLIC_URL=http://192.168.1.20:3000
# ADMIN_EMAILS=you@example.com   # accounts that see the admin view
# AI_PRICES=my-model=1.25/10     # USD per million tokens, for non-Claude models
