{
  "expo": {
    "name": "Symbiose",
    "slug": "symbiose",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "symbiose",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "io.synapsr.symbiose",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Symbiose uses the camera to photograph your meals and scan barcodes.",
        "NSPhotoLibraryUsageDescription": "Symbiose lets you pick a meal photo from your library.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.io.synapsr.symbiose"]
      },
      "buildNumber": "6",
      "appleTeamId": "3RZSUHDN87"
    },
    "android": {
      "package": "io.synapsr.symbiose",
      "adaptiveIcon": {
        "backgroundColor": "#F5F4F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.WRITE_BLOOD_PRESSURE",
        "android.permission.health.WRITE_NUTRITION",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.WRITE_HYDRATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F4F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0A0A0B",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Symbiose uses the camera to photograph your meals and scan barcodes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Symbiose lets you pick a meal photo from your library."
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Symbiose reads your steps, active energy, workouts, weight, height, sex and date of birth to fill in your profile and adapt your daily budget, and, only if you choose to track them, your sleep, the water you drink and your blood pressure.",
          "NSHealthUpdateUsageDescription": "Symbiose saves the nutrition of the meals you log to Apple Health, and, if you track them, the glasses of water and the blood pressure readings you add.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/with-watch-shared",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
