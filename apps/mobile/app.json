{
  "expo": {
    "name": "Symbiose",
    "slug": "symbiose",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "symbiose",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "io.synapsr.symbiose",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Symbiose uses the camera to photograph your meals and scan barcodes.",
        "NSPhotoLibraryUsageDescription": "Symbiose lets you pick a meal photo from your library.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSLocalNetworkUsageDescription": "Symbiose reaches an AI server on your network (Ollama, LM Studio) only if you set one up in Your AI."
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.io.synapsr.symbiose"]
      },
      "buildNumber": "18",
      "appleTeamId": "3RZSUHDN87"
    },
    "android": {
      "package": "io.synapsr.symbiose",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2C3036",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.WRITE_BLOOD_PRESSURE",
        "android.permission.health.WRITE_NUTRITION",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.WRITE_HYDRATION",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_RESTING_HEART_RATE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.c2dm.permission.RECEIVE",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F4F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0A0A0B",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Symbiose uses the camera to photograph your meals and scan barcodes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Symbiose lets you pick a meal photo from your library."
        }
      ],
      ["expo-secure-store", { "configureAndroidBackup": false }],
      "expo-localization",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Symbiose reads your steps, active energy, workouts, weight, height, sex and date of birth to fill in your profile and adapt your daily budget, and, only if you choose to track them, your sleep, the water you drink, your blood pressure, and your nightly heart rate variability and resting heart rate for the morning check-in.",
          "NSHealthUpdateUsageDescription": "Symbiose saves the nutrition of the meals you log to Apple Health, and, if you track them, the glasses of water and the blood pressure readings you add.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0F7663",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/with-watch-shared",
      "./plugins/with-android-signing",
      "@bacons/apple-targets",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Symbiose uses the microphone so you can dictate your meals, notes and questions instead of typing them. Your voice is turned into text and never recorded.",
          "speechRecognitionPermission": "Symbiose turns what you dictate into text, on your iPhone whenever it can."
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "./plugins/with-backup-rules"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
