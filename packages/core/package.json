{
  "name": "@symbiose/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Symbiose API (routes, services, AI adapters, schema), runtime-agnostic: run by the Node server and inside the app.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node scripts/generate.mjs",
    "migrations:check": "node scripts/bundle-migrations.mjs --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@symbiose/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "openai": "7.35.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
